rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function pilotOwner(uid) {
      return request.auth != null && request.auth.uid == uid
        && get(/databases/$(database)/documents/pilotUsers/$(uid)).data.enabled == true;
    }

    function isoDateTime(value) {
      return value is string && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{3}Z$');
    }

    function boundedString(value, maximum) {
      return value is string && value.size() <= maximum;
    }

    function cents(value) {
      return value == null || (value is int && value >= -100000000 && value <= 100000000);
    }

    function monthKey(value) {
      return value is string && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
    }

    // A self-service profile can only unlock the authenticated person's own
    // isolated ledger. It grants no access to any other account or collection.
    function validPilotProfile(data, uid) {
      return data.keys().hasAll(['uid', 'enabled', 'createdAt'])
        && data.keys().hasOnly(['uid', 'enabled', 'createdAt'])
        && data.uid == uid && data.enabled == true && isoDateTime(data.createdAt);
    }

    // The global revision provides an atomic snapshot barrier. Domain timestamps
    // stay separate so an unrelated sale does not stale a settings editor.
    function advancesCloudRevision(uid) {
      return getAfter(/databases/$(database)/documents/users/$(uid)/settings/primary).data.cloudRevision
        == get(/databases/$(database)/documents/users/$(uid)/settings/primary).data.cloudRevision + 1;
    }

    function validSale(data, saleId) {
      return data.keys().hasAll([
          'id', 'profileId', 'saleDate', 'customerLastName', 'stockNumber',
          'vehicleDescription', 'status', 'unitCreditBasis', 'frontGrossCents',
          'fiGrossCents', 'notes', 'createdAt', 'updatedAt', 'revision'
        ]) && data.keys().hasOnly([
          'id', 'profileId', 'saleDate', 'customerLastName', 'stockNumber',
          'vehicleDescription', 'status', 'unitCreditBasis', 'frontGrossCents',
          'frontCommissionOverrideCents', 'fiGrossCents', 'serviceContractSold',
          'tireWheelSold', 'gapSold', 'paymentMethod', 'dealerFinanced', 'notes',
          'createdAt', 'updatedAt', 'revision', 'deletedAt', 'source', 'sourceReference'
        ])
        && data.id == saleId && boundedString(data.id, 160) && data.id.size() > 0
        && data.profileId == 'primary'
        && data.saleDate is string && data.saleDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && boundedString(data.customerLastName, 60)
        && boundedString(data.stockNumber, 40)
        && boundedString(data.vehicleDescription, 120)
        && data.status in ['delivered', 'pending']
        && data.unitCreditBasis is int && data.unitCreditBasis >= 0 && data.unitCreditBasis <= 2000
        && cents(data.frontGrossCents) && cents(data.fiGrossCents)
        && (data.get('frontCommissionOverrideCents', null) == null
          || (data.frontCommissionOverrideCents is int && data.frontCommissionOverrideCents >= 0
            && data.frontCommissionOverrideCents <= 100000000))
        && data.get('serviceContractSold', false) is bool
        && data.get('tireWheelSold', false) is bool
        && data.get('gapSold', false) is bool
        && data.get('dealerFinanced', false) is bool
        && data.get('paymentMethod', 'cash') in ['dealer_financed', 'cash', 'outside_financing']
        && boundedString(data.notes, 500)
        && isoDateTime(data.createdAt) && isoDateTime(data.updatedAt)
        && data.revision is int && data.revision >= 1 && data.revision <= 2147483647
        && (!('deletedAt' in data) || isoDateTime(data.deletedAt))
        // Migration, workbook imports, and fictional demos are disabled in v1.
        && data.get('source', 'manual') == 'manual'
        && boundedString(data.get('sourceReference', ''), 240);
    }

    function validPayPlan(plan) {
      return plan is map && plan.keys().hasAll([
          'version', 'effectiveMonth', 'baseFrontRateBps', 'acceleratedFrontRateBps',
          'acceleratedThresholdExclusive', 'fiRateBps', 'bonusTiers'
        ]) && plan.keys().hasOnly([
          'version', 'effectiveMonth', 'baseFrontRateBps', 'acceleratedFrontRateBps',
          'acceleratedThresholdExclusive', 'fiRateBps', 'minimumFrontCommissionCents', 'bonusTiers'
        ])
        && boundedString(plan.version, 120) && plan.version.size() > 0
        && monthKey(plan.effectiveMonth)
        && plan.baseFrontRateBps is int && plan.baseFrontRateBps >= 0 && plan.baseFrontRateBps <= 10000
        && plan.acceleratedFrontRateBps is int && plan.acceleratedFrontRateBps >= 0 && plan.acceleratedFrontRateBps <= 10000
        && plan.acceleratedThresholdExclusive is int && plan.acceleratedThresholdExclusive >= 0 && plan.acceleratedThresholdExclusive <= 100
        && plan.fiRateBps is int && plan.fiRateBps >= 0 && plan.fiRateBps <= 10000
        && plan.get('minimumFrontCommissionCents', 30000) is int
        && plan.get('minimumFrontCommissionCents', 30000) >= 0
        && plan.get('minimumFrontCommissionCents', 30000) <= 100000000
        && plan.bonusTiers is list && plan.bonusTiers.size() <= 20;
    }

    // Explicit top-level contract, not a claim of full recursive validation.
    // The application must validate all month-map values and nested plan lists.
    function validSettings(data) {
      return data.keys().hasAll([
          'id', 'salespersonName', 'storeName', 'monthlyGoal', 'monthlyCommissionGoalCents',
          'daysOffByMonth', 'selectedMonth', 'selectedView', 'actualPaidByMonth',
          'payPlan', 'payPlanHistory', 'onboardingDismissed', 'lastBackupAt',
          'createdAt', 'updatedAt', 'cloudRevision'
        ]) && data.keys().hasOnly([
          'id', 'salespersonName', 'storeName', 'monthlyGoal', 'monthlyCommissionGoalCents',
          'deliveryGoalsByMonth', 'commissionGoalsByMonth', 'daysOffByMonth',
          'selectedMonth', 'selectedView', 'actualPaidByMonth', 'payPlan', 'payPlanHistory',
          'onboardingDismissed', 'lastBackupAt', 'createdAt', 'updatedAt', 'cloudRevision'
        ])
        && data.id == 'primary'
        && boundedString(data.salespersonName, 80) && boundedString(data.storeName, 120)
        && data.monthlyGoal is int && data.monthlyGoal >= 1 && data.monthlyGoal <= 100
        && (data.monthlyCommissionGoalCents == null
          || (data.monthlyCommissionGoalCents is int && data.monthlyCommissionGoalCents >= 100
            && data.monthlyCommissionGoalCents <= 100000000))
        && data.get('deliveryGoalsByMonth', {}) is map && data.get('deliveryGoalsByMonth', {}).size() <= 600
        && data.get('commissionGoalsByMonth', {}) is map && data.get('commissionGoalsByMonth', {}).size() <= 600
        && data.daysOffByMonth is map && data.daysOffByMonth.size() <= 600
        && data.actualPaidByMonth is map && data.actualPaidByMonth.size() <= 600
        && monthKey(data.selectedMonth) && data.selectedView in ['dashboard', 'sales', 'reports', 'settings']
        && validPayPlan(data.payPlan)
        && data.payPlanHistory is list && data.payPlanHistory.size() <= 50
        && data.onboardingDismissed is bool
        && (data.lastBackupAt == null || isoDateTime(data.lastBackupAt))
        && isoDateTime(data.createdAt) && isoDateTime(data.updatedAt)
        && data.cloudRevision is int && data.cloudRevision >= 0 && data.cloudRevision <= 2147483647;
    }

    function validAudit(data) {
      return data.keys().hasAll(['id', 'profileId', 'action', 'occurredAt', 'summary'])
        && data.keys().hasOnly(['id', 'profileId', 'action', 'entityId', 'occurredAt', 'summary', 'details'])
        && data.id is int && data.id >= 1
        && data.profileId == 'primary'
        && data.action in ['sale.created', 'sale.updated', 'sale.deleted', 'sale.restored', 'settings.updated', 'backup.exported']
        && isoDateTime(data.occurredAt) && boundedString(data.summary, 500)
        && boundedString(data.get('entityId', ''), 160)
        && data.get('details', {}) is map && data.get('details', {}).size() <= 40;
    }

    function validDraftValues(values) {
      return values is map && values.keys().hasAll([
          'status', 'saleDate', 'customerLastName', 'stockNumber', 'vehicleDescription',
          'unitCredit', 'frontGross', 'fiGross', 'manualFrontCommissionEnabled', 'frontCommissionOverride', 'notes'
        ]) && values.keys().hasOnly([
          'status', 'saleDate', 'customerLastName', 'stockNumber', 'vehicleDescription',
          'unitCredit', 'frontGross', 'fiGross', 'manualFrontCommissionEnabled', 'frontCommissionOverride', 'notes'
        ]) && values.status in ['delivered', 'pending']
        && boundedString(values.saleDate, 32) && boundedString(values.customerLastName, 120)
        && boundedString(values.stockNumber, 80) && boundedString(values.vehicleDescription, 240)
        && boundedString(values.unitCredit, 40) && boundedString(values.frontGross, 80)
        && boundedString(values.fiGross, 80) && values.manualFrontCommissionEnabled is bool
        && boundedString(values.frontCommissionOverride, 80) && boundedString(values.notes, 1000);
    }

    function validDraftProducts(products) {
      return products is map && products.keys().hasOnly([
          'serviceContractSold', 'tireWheelSold', 'gapSold', 'dealerFinanced', 'paymentMethod'
        ]) && products.get('serviceContractSold', false) is bool
        && products.get('tireWheelSold', false) is bool && products.get('gapSold', false) is bool
        && products.get('dealerFinanced', false) is bool
        && products.get('paymentMethod', 'cash') in ['dealer_financed', 'cash', 'outside_financing'];
    }

    function validDraftPayload(payload, key) {
      return payload is map && payload.keys().hasAll(['draftId', 'baseSale', 'values', 'fiProducts'])
        && payload.keys().hasOnly(['draftId', 'baseSale', 'values', 'fiProducts'])
        && boundedString(payload.draftId, 160) && payload.draftId.size() > 0
        && payload.draftId.matches('^[^/]+$') && !(payload.draftId in ['.', '..'])
        && !payload.draftId.matches('^__.*__$')
        && (key == 'new-sale' || key == 'sale:' + payload.draftId)
        && (payload.baseSale == null || validSale(payload.baseSale, payload.draftId))
        && validDraftValues(payload.values) && validDraftProducts(payload.fiProducts);
    }

    function validDraft(data, key) {
      return data.keys().hasAll(['key', 'revision', 'updatedAt', 'payload'])
        && data.keys().hasOnly(['key', 'revision', 'updatedAt', 'payload'])
        && data.key == key && boundedString(key, 165)
        && (key == 'new-sale' || key.matches('^sale:[^/]+$'))
        && data.revision is int && data.revision >= 1 && data.revision <= 2147483647
        && isoDateTime(data.updatedAt)
        && (data.payload == null || validDraftPayload(data.payload, key));
    }

    match /pilotUsers/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && validPilotProfile(request.resource.data, uid);
      allow list, update, delete: if false;
    }

    match /users/{uid}/settings/{settingsId} {
      allow get, list: if pilotOwner(uid) && settingsId == 'primary';
      allow create: if pilotOwner(uid) && settingsId == 'primary'
        && validSettings(request.resource.data) && request.resource.data.cloudRevision == 0;
      allow update: if pilotOwner(uid) && settingsId == 'primary'
        && validSettings(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.cloudRevision == resource.data.cloudRevision + 1;
      allow delete: if false;
    }

    match /users/{uid}/sales/{saleId} {
      allow get, list: if pilotOwner(uid);
      allow create: if pilotOwner(uid) && validSale(request.resource.data, saleId)
        && request.resource.data.revision == 1 && !('deletedAt' in request.resource.data)
        && advancesCloudRevision(uid);
      allow update: if pilotOwner(uid) && validSale(request.resource.data, saleId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.updatedAt != resource.data.updatedAt
        && getAfter(/databases/$(database)/documents/users/$(uid)/saleHistory/$(saleId)/versions/$(string(resource.data.revision))).data == resource.data
        && advancesCloudRevision(uid);
      allow delete: if false;
    }

    match /users/{uid}/saleHistory/{saleId}/versions/{revision} {
      allow get, list: if pilotOwner(uid);
      allow create: if pilotOwner(uid)
        && request.resource.data == get(/databases/$(database)/documents/users/$(uid)/sales/$(saleId)).data
        && revision == string(request.resource.data.revision)
        && getAfter(/databases/$(database)/documents/users/$(uid)/sales/$(saleId)).data.revision == request.resource.data.revision + 1
        && advancesCloudRevision(uid);
      allow update, delete: if false;
    }

    match /users/{uid}/auditEvents/{eventId} {
      allow get, list: if pilotOwner(uid);
      allow create: if pilotOwner(uid) && boundedString(eventId, 160)
        && validAudit(request.resource.data) && advancesCloudRevision(uid)
        && request.resource.data.id == getAfter(/databases/$(database)/documents/users/$(uid)/settings/primary).data.cloudRevision;
      allow update, delete: if false;
    }

    // Incomplete editor entries never become sales or affect account totals.
    // Clearing retains a content-free revision so stale tabs cannot resurrect it.
    match /users/{uid}/drafts/{key} {
      allow get, list: if pilotOwner(uid);
      allow create: if pilotOwner(uid) && validDraft(request.resource.data, key)
        && request.resource.data.revision == 1;
      allow update: if pilotOwner(uid) && validDraft(request.resource.data, key)
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.updatedAt != resource.data.updatedAt;
      allow delete: if false;
    }

    // No public data, manager role, or catch-all authenticated access. The only
    // client enrollment is the narrowly validated own-UID profile above. Any
    // newly added collection remains closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
