# Default / GitHub Pages builds remain local-only.
VITE_FIREBASE_ENABLED=false
VITE_PUBLIC_DEMO=false

# Copy the public Firebase web-app config into .env.cloud.local for a private build.
# These web values identify the app; NEVER add a service-account key or admin token.
# VITE_FIREBASE_ENABLED=true
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=

# Local automated tests only. Rejected on non-loopback hosts.
# VITE_FIREBASE_EMULATORS=true
